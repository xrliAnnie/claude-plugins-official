{
	"contract": "discord-inbound-classifier/v1",
	"base": {
		"channelKind": "guild",
		"policyChannelId": "100000000000000002",
		"senderId": "100000000000000003",
		"isSelf": false,
		"authorIsBot": false,
		"content": "Please inspect this failure.",
		"mentionMatched": true,
		"topicThread": false,
		"requireOwner": true,
		"leadId": "eng-lead",
		"ownerLeadId": "eng-lead",
		"access": {
			"dmPolicy": "pairing",
			"allowFrom": ["100000000000000003"],
			"allowBots": ["100000000000000004"],
			"groups": {
				"100000000000000002": {
					"requireMention": true,
					"allowFrom": ["100000000000000003", "100000000000000004"]
				}
			}
		}
	},
	"cases": [
		{
			"name": "explicit mention accepted",
			"patch": {},
			"expected": { "action": "deliver", "classification": "chat" }
		},
		{
			"name": "verified reply to owner counts as resolved mention",
			"patch": { "content": "reply to owner", "mentionMatched": true },
			"expected": { "action": "deliver", "classification": "chat" }
		},
		{
			"name": "no mention on mentioned room",
			"patch": { "mentionMatched": false },
			"expected": { "action": "drop", "reason": "mention_required" }
		},
		{
			"name": "unregistered channel",
			"patch": { "policyChannelId": "100000000000000099" },
			"expected": { "action": "drop", "reason": "group_disabled" }
		},
		{
			"name": "group sender outside allowlist",
			"patch": { "senderId": "100000000000000099" },
			"expected": { "action": "drop", "reason": "sender_not_allowed" }
		},
		{
			"name": "owner unknown held",
			"patch": { "ownerLeadId": null },
			"expected": { "action": "quarantine", "reason": "owner_unproven" }
		},
		{
			"name": "another owner never broadcast",
			"patch": { "ownerLeadId": "cos-lead" },
			"expected": { "action": "drop", "reason": "different_owner" }
		},
		{
			"name": "self echo discarded",
			"patch": { "isSelf": true },
			"expected": { "action": "drop", "reason": "self_echo" }
		},
		{
			"name": "unapproved bot",
			"patch": { "authorIsBot": true, "senderId": "100000000000000099" },
			"expected": { "action": "drop", "reason": "bot_not_allowed" }
		},
		{
			"name": "approved bot uses same room gate",
			"patch": { "authorIsBot": true, "senderId": "100000000000000004" },
			"expected": { "action": "deliver", "classification": "chat" }
		},
		{
			"name": "DM allowlisted",
			"patch": { "channelKind": "dm", "mentionMatched": false },
			"expected": { "action": "deliver", "classification": "chat" }
		},
		{
			"name": "DM pairing retains original path",
			"patch": { "channelKind": "dm", "senderId": "100000000000000099" },
			"expected": { "action": "pair" }
		},
		{
			"name": "permission yes exact alphabet",
			"patch": { "content": " Yes abcde \n" },
			"expected": {
				"action": "deliver",
				"classification": "permission",
				"requestId": "abcde",
				"behavior": "allow"
			}
		},
		{
			"name": "permission no case fold",
			"patch": { "content": "NO KMMZZ" },
			"expected": {
				"action": "deliver",
				"classification": "permission",
				"requestId": "kmmzz",
				"behavior": "deny"
			}
		},
		{
			"name": "permission cannot bypass mention",
			"patch": { "content": "yes abcde", "mentionMatched": false },
			"expected": { "action": "drop", "reason": "mention_required" }
		},
		{
			"name": "excluded letter l remains ordinary chat",
			"patch": { "content": "yes abcle" },
			"expected": { "action": "deliver", "classification": "chat" }
		},
		{
			"name": "four-letter token remains chat",
			"patch": { "content": "y abcd" },
			"expected": { "action": "deliver", "classification": "chat" }
		},
		{
			"name": "permission with suffix remains chat",
			"patch": { "content": "yes abcde please" },
			"expected": { "action": "deliver", "classification": "chat" }
		},
		{
			"name": "topic decision unavailable held",
			"patch": { "topicThread": true },
			"expected": { "action": "quarantine", "reason": "topic_policy_unproven" }
		},
		{
			"name": "topic budget exhausted",
			"patch": { "topicThread": true, "topicDecision": "drop" },
			"expected": { "action": "drop", "reason": "topic_policy_denied" }
		},
		{
			"name": "topic member relaxation uses proved budget",
			"patch": {
				"topicThread": true,
				"topicDecision": "deliver",
				"mentionMatched": false
			},
			"expected": { "action": "deliver", "classification": "chat" }
		},
		{
			"name": "missing policy held",
			"patch": { "access": null },
			"expected": { "action": "quarantine", "reason": "policy_unavailable" }
		},
		{
			"name": "malformed sender held",
			"patch": { "senderId": "not-id" },
			"expected": { "action": "quarantine", "reason": "message_invalid" }
		}
	]
}
